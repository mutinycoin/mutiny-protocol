# ISOLATED CANDIDATE, NOT FITTED-PANEL QUALIFICATION OR FLASH APPROVAL.
# Exact V4.3 board-photo/schematic pin profile; not automatic V4.3.1 substitution.
# V4.2 + V4.3.1 datasheets: SSD1315. V4 factory BSP: 0x3C, SSD1306Wire.
# Vext LOW is selected from exact V4.3 P-channel schematic and V4 factory code.
# Newer V4.3.1 prose says HIGH: conflict retained; no automatic polarity toggle.
CONFIG_LORA_DISPLAY_ENABLE=y
CONFIG_LORA_DISPLAY_SDA_GPIO=17
CONFIG_LORA_DISPLAY_SCL_GPIO=18
CONFIG_LORA_DISPLAY_RST_GPIO=21
CONFIG_LORA_DISPLAY_VEXT_GPIO=36
CONFIG_LORA_DISPLAY_VEXT_ACTIVE_LEVEL=0
CONFIG_LORA_DISPLAY_I2C_ADDR=60
CONFIG_LORA_DISPLAY_SSD13XX_VENDOR_PROFILE_CANDIDATE=y
