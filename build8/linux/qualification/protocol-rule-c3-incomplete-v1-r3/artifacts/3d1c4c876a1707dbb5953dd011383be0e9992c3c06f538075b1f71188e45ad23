                    first.set_leap_view(view);
                    let offered = first.calibrate(&one(utc, unc, e.now()));
                    assert_eq!(offered.is_ok(), admitted, "{kind:?} utc {utc} unc {unc}: {offered:?}");
                    let second = assessed(q250(), e.clone());
