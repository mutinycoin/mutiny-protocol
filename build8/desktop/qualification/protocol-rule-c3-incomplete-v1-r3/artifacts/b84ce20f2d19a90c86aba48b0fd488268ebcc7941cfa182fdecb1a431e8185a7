            .as_bytes()
            .try_into()
            .unwrap();
        HeightAuthority {
            parent: FinalizedAnchor {
                network: NETWORK_ID,
                genesis: [1; 32],
                fingerprint: [2; 32],
                height: 0,
                block: [3; 32],
            },
            membership: [4; 32],
            reputation: [5; 32],
            attestation: [6; 32],
            voters: std::collections::BTreeMap::from([(
