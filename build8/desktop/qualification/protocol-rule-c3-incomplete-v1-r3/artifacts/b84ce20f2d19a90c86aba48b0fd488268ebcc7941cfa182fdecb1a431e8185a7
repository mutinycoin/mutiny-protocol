                    lineage: [8; 32],
                    admitted: true,
                    physical: true,
                    eligible: true,
                    revoked: false,
                    hardware_generation: 1,
                    key_generation: 1,
                    tpm_public: tpm,
                    profile: [10; 32],
                    public: key.clone(),
                    reputation: 1u64.into(),
                },
            )]),
        }
    }
