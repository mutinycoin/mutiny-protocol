fn intent(domain: Domain, payload: &[u8]) -> Result<[u8; 64]> {
    #[cfg(feature="receipt-qualification")]
    if let Domain::QualificationReceipt(bound) = domain {
        if payload != bound.body() { return Err(Error::Encoding); }
    }
    if payload.len() > 1024 * 1024 {
        return Err(Error::Encoding);
    }
    let mut h = Sha512::new();
    h.update(domain.bytes());
    h.update([0]);
    h.update(payload);
    Ok(h.finalize().into())
}
