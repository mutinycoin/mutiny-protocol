    /// One chrony-like sample measured at `at`.
    fn one(utc: u64, unc: u64, at: Elapsed) -> [SourceSample; 1] {
        [sample("chrony-nts", utc, unc, at)]
    }
    fn half(c: &HoldoverClock) -> u64 {
        match c.status() {
            Status::Qualified { half_width_ms, .. } => half_width_ms,
            s => panic!("{s:?}"),
