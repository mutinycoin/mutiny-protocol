            assert_eq!((d.lower_bound_ms(), d.anchor_interval_ms()), (None, None));
            assert!(d.persisted(1, 1).is_none(), "nothing is left to persist");
            d.set_leap_view(OPEN);
            assert_eq!(d.lower_bound_ms(), None, "a later view does not revive it");
        }
    }

