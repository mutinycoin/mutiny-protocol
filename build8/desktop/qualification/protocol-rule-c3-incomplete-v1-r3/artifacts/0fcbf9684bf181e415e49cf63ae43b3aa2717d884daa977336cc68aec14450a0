struct Local(Ptr);
impl Drop for Local {
    fn drop(&mut self) {
        unsafe {
            LocalFree(self.0);
        }
    }
}
fn wide(value: &std::ffi::OsStr) -> Vec<u16> {
    value.encode_wide().chain([0]).collect()
}
fn api_path(path: &Path) -> Vec<u16> {
    // Extended Win32 namespace disables ordinary slash normalization. Preserve arbitrary
    // UTF16 components while converting the separators accepted by the public drive path.
    "\\\\?\\"
        .encode_utf16()
        .chain(path.as_os_str().encode_wide().map(|c| {
            if c == u16::from(b'/') {
                u16::from(b'\\')
            } else {
                c
            }
        }))
        .chain([0])
        .collect()
}
fn text(value: &str) -> Vec<u16> {
    value.encode_utf16().chain([0]).collect()
}
fn last(path: &Path) -> StorageError {
    io(path, std::io::Error::last_os_error())
}
fn access(path: &Path) -> StorageError {
    StorageError::Accessible(path.into())
}

// Keep token data usize-aligned: TOKEN_USER contains a SID pointer into this allocation.
struct Identity {
    token_data: Vec<usize>,
    user_text: String,
    system: Local,
    admins: Local,
    installer: Local,
}
impl Identity {
    fn new(path: &Path) -> Result<Self, StorageError> {
        unsafe {
            let mut token = null_mut();
            if OpenProcessToken(GetCurrentProcess(), 8, &mut token) == 0 {
                return Err(last(path));
            }
            let mut needed = 0;
            GetTokenInformation(token, 1, null_mut(), 0, &mut needed);
            if needed == 0 || needed > 65536 {
                CloseHandle(token);
                return Err(access(path));
            }
            let mut data = vec![0usize; (needed as usize).div_ceil(size_of::<usize>())];
            let ok = GetTokenInformation(token, 1, data.as_mut_ptr().cast(), needed, &mut needed);
            CloseHandle(token);
            if ok == 0 {
                return Err(last(path));
            }
            let sid = *(data.as_ptr() as *const Ptr);
            if IsValidSid(sid) == 0 {
                return Err(access(path));
            }
            let mut value = null_mut();
            if ConvertSidToStringSidW(sid, &mut value) == 0 {
                return Err(last(path));
            }
            let allocation = Local(value.cast());
            let mut n = 0;
            while *value.add(n) != 0 {
                n += 1;
                if n > 256 {
                    return Err(access(path));
                }
            }
            let user_text = String::from_utf16(std::slice::from_raw_parts(value, n))
                .map_err(|_| access(path))?;
            drop(allocation);
            let make = |value: &str| -> Result<Local, StorageError> {
                let mut sid = null_mut();
                if ConvertStringSidToSidW(text(value).as_ptr(), &mut sid) == 0 {
                    return Err(last(path));
                }
                Ok(Local(sid))
            };
            Ok(Self {
                token_data: data,
                user_text,
                system: make("S-1-5-18")?,
                admins: make("S-1-5-32-544")?,
                installer: make("S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464")?,
            })
        }
    }
    fn user(&self) -> Ptr {
        unsafe { *(self.token_data.as_ptr() as *const Ptr) }
    }
    fn trusted(&self, sid: Ptr) -> bool {
        unsafe {
            EqualSid(sid, self.user()) != 0
                || [self.system.0, self.admins.0, self.installer.0]
                    .iter()
                    .any(|s| EqualSid(sid, *s) != 0)
        }
    }
    fn descriptor(&self, path: &Path, directory: bool) -> Result<Local, StorageError> {
        // Explicit current-user owner, not the elevated token's default Administrators owner.
        let flags = if directory { "OICI" } else { "" };
        let value = text(&format!(
            "O:{}D:P(A;{flags};FA;;;SY)(A;{flags};FA;;;{})",
            self.user_text, self.user_text
        ));
        let mut sd = null_mut();
        if unsafe {
            ConvertStringSecurityDescriptorToSecurityDescriptorW(
                value.as_ptr(),
                1,
                &mut sd,
                null_mut(),
            )
        } == 0
        {
            return Err(last(path));
        }
        Ok(Local(sd))
    }
    fn check(&self, file: &File, path: &Path, private: bool) -> Result<(), StorageError> {
        unsafe {
            let mut sd = null_mut();
            let mut owner = null_mut();
            let mut acl = null_mut();
            let code = GetSecurityInfo(
                file.as_raw_handle(),
                1,
                1 | 4,
                &mut owner,
                null_mut(),
                &mut acl,
                null_mut(),
                &mut sd,
            );
            if code != 0 {
                return Err(io(path, std::io::Error::from_raw_os_error(code as i32)));
            }
            let _allocation = Local(sd);
            if owner.is_null()
                || IsValidSid(owner) == 0
                || (private && EqualSid(owner, self.user()) == 0)
                || (!private && !self.trusted(owner))
            {
                return Err(if private {
                    StorageError::NotOwner(path.into())
                } else {
                    StorageError::ReplaceableAncestor(path.into())
                });
            }
            if acl.is_null() {
                return Err(access(path));
            } // Null DACL grants everyone.
            let mut control = 0;
            let mut revision = 0;
            if GetSecurityDescriptorControl(sd, &mut control, &mut revision) == 0
                || (private && (control & 0x1000 == 0 || (*acl).count != 2))
            {
                return Err(access(path));
            }
            let (mut user, mut system) = (false, false);
            for i in 0..u32::from((*acl).count) {
                let mut raw = null_mut();
                if GetAce(acl, i, &mut raw) == 0 {
                    return Err(access(path));
                }
                let ace = &*(raw as *const Ace);
                if !private && ace.flags & 8 != 0 {
                    continue;
                } // inherit-only, not applicable
                if !private && ace.kind == 1 {
                    continue;
                } // denial never grants access
                if ace.kind != 0 || ace.size < 16 {
                    return Err(access(path));
                }
                let sid = std::ptr::addr_of!(ace.sid) as Ptr;
                if IsValidSid(sid) == 0 || GetLengthSid(sid) > u32::from(ace.size) - 8 {
                    return Err(access(path));
                }
                if private {
                    // Strict supported policy; inherited/null/conditional/foreign grants refused.
                    if ace.flags & (8 | 16) != 0 || ace.mask != 0x1f01ff {
                        return Err(access(path));
                    }
                    if EqualSid(sid, self.user()) != 0 && !user {
                        user = true;
                    } else if EqualSid(sid, self.system.0) != 0 && !system {
                        system = true;
                    } else {
                        return Err(access(path));
                    }
                } else if !self.trusted(sid)
                    && ace.mask
                        & (0x2
                            | 0x10
                            | 0x100
                            | 0x40
                            | DELETE
                            | 0x40000
                            | 0x80000
                            | 0x10000000
                            | WRITE)
                        != 0
                {
                    return Err(StorageError::ReplaceableAncestor(path.into()));
                }
            }
            if private && (!user || !system) {
                return Err(access(path));
            }
        }
        Ok(())
    }
}

fn open(
    path: &Path,
    access: u32,
    disposition: u32,
    security: Option<&Local>,
    directory: bool,
) -> Result<File, StorageError> {
    open_raw(path, access, disposition, security, directory).map_err(|e| io(path, e))
}
fn open_raw(
    path: &Path,
    access: u32,
    disposition: u32,
    security: Option<&Local>,
    directory: bool,
) -> std::io::Result<File> {
    let attributes = SecurityAttributes {
        length: size_of::<SecurityAttributes>() as u32,
        descriptor: security.map_or(null_mut(), |s| s.0),
        inherit: 0,
    };
    let flags = NO_FOLLOW
        | if directory {
            BACKUP
        } else {
            0x80 | WRITE_THROUGH
        };
    let handle = unsafe {
        CreateFileW(
            api_path(path).as_ptr(),
            access | if directory { READ } else { 0 },
            1 | 2,
            &attributes,
            disposition,
            flags,
            null_mut(),
        )
    };
    if handle == (-1isize) as Ptr {
        return Err(std::io::Error::last_os_error());
    }
    // SAFETY: sole owned non-inheritable CreateFileW handle, consumed exactly once.
    let file = unsafe { File::from_raw_handle(handle) };
    let mut inherited = 0;
    if unsafe { GetHandleInformation(handle, &mut inherited) } == 0 || inherited & 1 != 0 {
        return Err(std::io::Error::new(
            std::io::ErrorKind::PermissionDenied,
            "inheritable or unreadable Windows handle",
        ));
    }
    Ok(file)
}
fn inspect(file: &File, path: &Path, directory: bool) -> Result<FileId, StorageError> {
    let mut old = [0u32; 13];
    let mut id = FileId::default();
    unsafe {
        if GetFileInformationByHandle(file.as_raw_handle(), old.as_mut_ptr()) == 0
            || GetFileInformationByHandleEx(
                file.as_raw_handle(),
                18,
                (&mut id as *mut FileId).cast(),
                size_of::<FileId>() as u32,
            ) == 0
        {
            return Err(last(path));
        }
    }
    if old[0] & 0x400 != 0 {
        return Err(StorageError::Symlink(path.into()));
    }
    if (old[0] & 0x10 != 0) != directory {
        return Err(StorageError::Path(path.into()));
    }
    if !directory && old[10] != 1 {
        return Err(access(path));
    }
    Ok(id)
}
fn check_volume(file: &File, path: &Path) -> Result<(), StorageError> {
    let mut flags = 0;
    let mut fs = [0u16; 32];
    if unsafe {
        GetVolumeInformationByHandleW(
            file.as_raw_handle(),
            null_mut(),
            0,
            null_mut(),
            null_mut(),
            &mut flags,
            fs.as_mut_ptr(),
            fs.len() as u32,
        )
    } == 0
    {
        return Err(last(path));
    }
    // Narrow first supported backend. ReFS/network/device semantics are not inferred from NTFS.
    if flags & 8 == 0
        || String::from_utf16_lossy(&fs[..fs.iter().position(|c| *c == 0).unwrap_or(fs.len())])
            != "NTFS"
    {
        return Err(StorageError::Unsupported(
            "clock storage requires local NTFS persistent ACLs",
        ));
    }
    Ok(())
}
pub(super) fn strict(path: &Path) -> Result<(), StorageError> {
    if !matches!(path.components().next(),Some(Component::Prefix(p)) if matches!(p.kind(),Prefix::Disk(_)))
    {
        return Err(StorageError::Path(path.into()));
    }
    // Reject Win32 alias syntax (streams, device names, trailing dots/spaces) and explicit dots.
    let spelling = path.as_os_str().to_string_lossy().replace('/', "\\");
    if spelling.split('\\').any(|v| v == "." || v == "..") {
        return Err(StorageError::Path(path.into()));
    }
    for c in path.components() {
        if let Component::Normal(n) = c {
            let n = n.to_string_lossy();
            let stem = n.split('.').next().unwrap_or("").to_ascii_uppercase();
            if n.ends_with(['.', ' '])
                || n.contains([':', '\0'])
                || [
                    "CON", "PRN", "AUX", "NUL", "COM1", "COM2", "COM3", "COM4", "COM5", "COM6",
                    "COM7", "COM8", "COM9", "LPT1", "LPT2", "LPT3", "LPT4", "LPT5", "LPT6", "LPT7",
                    "LPT8", "LPT9",
                ]
                .contains(&stem.as_str())
            {
                return Err(StorageError::Path(path.into()));
            }
        }
    }
    Ok(())
}

#[derive(Debug)]
pub(super) struct WindowsStateDir {
    _handles: Vec<File>,
    path: PathBuf,
}
impl WindowsStateDir {
    pub(super) fn secure(dir: &Path) -> Result<Self, StorageError> {
        strict(dir)?;
        let root = dir.components().take(2).collect::<PathBuf>();
        if unsafe { GetDriveTypeW(wide(root.as_os_str()).as_ptr()) } != 3 {
            return Err(StorageError::Unsupported(
                "clock storage requires a local fixed NTFS drive",
            ));
        }
        let identity = Identity::new(dir)?;
        let mut handles = Vec::new();
        let mut prefix = PathBuf::new();
        for component in dir.components() {
            prefix.push(component.as_os_str());
            if matches!(component, Component::Prefix(_)) {
                continue;
            }
            let leaf = prefix == dir;
            if leaf {
                let sd = identity.descriptor(dir, true)?;
                let attributes = SecurityAttributes {
                    length: size_of::<SecurityAttributes>() as u32,
                    descriptor: sd.0,
                    inherit: 0,
                };
                if unsafe { CreateDirectoryW(api_path(dir).as_ptr(), &attributes) } == 0 {
                    let e = std::io::Error::last_os_error();
                    if e.raw_os_error() != Some(183) {
                        return Err(io(dir, e));
                    }
                }
            }
            let handle = open(&prefix, READ_CONTROL, OPEN, None, true)?;
            let id = inspect(&handle, &prefix, true)?;
            if leaf {
                #[cfg(test)]
                BETWEEN_DIRECTORY_PIN_AND_REOPEN.with(|hook| {
                    if let Some(hook) = hook.take() {
                        hook(&prefix);
                    }
                });
                let named = open(&prefix, READ_CONTROL, OPEN, None, true)?;
                if inspect(&named, &prefix, true)? != id {
                    return Err(StorageError::Substituted(prefix.clone()));
                }
            }
            check_volume(&handle, &prefix)?;
            identity.check(&handle, &prefix, leaf)?;
            // No DELETE sharing: retained chain cannot be renamed/replaced by another handle.
            handles.push(handle);
        }
        Ok(Self {
            _handles: handles,
            path: dir.into(),
        })
    }
    fn file(&self, path: &Path, access: u32, create: bool) -> Result<Option<File>, StorageError> {
        strict(path)?;
        if path.parent() != Some(self.path.as_path()) {
            return Err(StorageError::Path(path.into()));
        }
        let identity = Identity::new(path)?;
        // DELETE access is incompatible with our no-delete-sharing probe. Retain ordinary
        // read handles; for a mutation compare a prior pinned identity after reopening DELETE.
        let prior = if access & DELETE != 0 {
            match open_raw(path, READ_CONTROL, OPEN, None, false) {
                Ok(probe) => Some(inspect(&probe, path, false)?),
                Err(e) if e.raw_os_error() == Some(2) => None,
                Err(e) => return Err(io(path, e)),
            }
        } else {
            None
        };
        #[cfg(test)]
        BETWEEN_MUTATION_OPEN.with(|hook| {
            if let Some(hook) = hook.take() {
                hook(path);
            }
        });
        let file = match open_raw(path, access | READ_CONTROL, OPEN, None, false) {
            Ok(file) => file,
            Err(e) if !create && e.raw_os_error() == Some(2) => return Ok(None),
            Err(e) => {
                // Only actual FILE_NOT_FOUND permits creation. Never truncate/repair an existing file.
                if e.raw_os_error() != Some(2) {
                    return Err(io(path, e));
                }
                let sd = identity.descriptor(path, false)?;
                match open_raw(path, access | READ_CONTROL, NEW, Some(&sd), false) {
                    Ok(file) => file,
                    Err(e) if e.raw_os_error() == Some(80) || e.raw_os_error() == Some(183) => {
                        open(path, access | READ_CONTROL, OPEN, None, false)?
                    }
                    Err(e) => return Err(io(path, e)),
                }
            }
        };
        let id = inspect(&file, path, false)?;
        identity.check(&file, path, true)?;
        if access & DELETE != 0 {
            if prior.as_ref().is_some_and(|prior| *prior != id) {
                return Err(StorageError::Substituted(path.into()));
            }
        } else {
            let named = open(path, READ_CONTROL, OPEN, None, false)?;
            if inspect(&named, path, false)? != id {
                return Err(StorageError::Substituted(path.into()));
            }
        }
        Ok(Some(file))
    }
    pub(super) fn lock(&self, path: &Path) -> Result<File, StorageError> {
        let file = self
            .file(path, READ | WRITE, true)?
            .ok_or_else(|| access(path))?;
        match file.try_lock() {
            Ok(()) => Ok(file),
            Err(std::fs::TryLockError::WouldBlock) => Err(StorageError::Locked(path.into())),
            Err(std::fs::TryLockError::Error(e)) => Err(io(path, e)),
        }
    }
    pub(super) fn check_entries(&self, entries: &[PathBuf]) -> Result<(), StorageError> {
        for path in entries {
            self.file(path, READ, false)?;
        }
        Ok(())
    }
    pub(super) fn read(&self, path: &Path, limit: usize) -> Result<Option<Vec<u8>>, StorageError> {
        let Some(file) = self.file(path, READ, false)? else {
            return Ok(None);
        };
        let mut raw = Vec::new();
        file.take(limit as u64 + 1)
            .read_to_end(&mut raw)
            .map_err(|e| io(path, e))?;
        Ok(Some(raw))
    }
    fn rename(&self, file: &File, target: &Path, replace: bool) -> Result<(), StorageError> {
        strict(target)?;
        if target.parent() != Some(self.path.as_path()) {
            return Err(StorageError::Path(target.into()));
        }
        // Win32 SetFileInformationByHandle rejected the relative root-handle form with native
        // ERROR_INVALID_PARAMETER in the retained positive attempt. Use its documented absolute
        // target form while every ancestor and the final directory remain pinned without DELETE
        // sharing; this is not a name-preflight/reopen-only substitution barrier.
        let name = api_path(target);
        let offset = offset_of!(Rename, name);
        // Win32's absolute-name conversion also consumes the terminating NUL. Preserve it in
        // the allocation and native buffer size although FileNameLength itself excludes NUL.
        let length = offset + name.len() * 2;
        // Native structure pointer alignment; FileNameLength excludes terminating NUL.
        let mut buffer = vec![0usize; length.div_ceil(size_of::<usize>())];
        let raw = buffer.as_mut_ptr() as *mut Rename;
        unsafe {
            (*raw).replace = u32::from(replace);
            (*raw).root = null_mut();
            (*raw).length = ((name.len() - 1) * 2) as u32;
            std::ptr::copy_nonoverlapping(
                name.as_ptr(),
                std::ptr::addr_of_mut!((*raw).name).cast(),
                name.len(),
            );
            if SetFileInformationByHandle(file.as_raw_handle(), 3, raw.cast(), length as u32) == 0 {
                return Err(last(target));
            }
        }
        Ok(())
    }
    pub(super) fn write(&self, path: &Path, bytes: &[u8]) -> Result<(), StorageError> {
        // Validate the old target through its handle before it can be replaced.
        self.file(path, READ, false)?;
        let tmp = super::sibling(path, ".tmp");
        // Preserve crash leftovers instead of deleting partial evidence.
        if let Some(old) = self.file(&tmp, READ | DELETE, false)? {
            let mut salt = [0u8; 16];
            getrandom::getrandom(&mut salt)
                .map_err(|e| StorageError::Io(tmp.clone(), e.to_string()))?;
            self.rename(
                &old,
                &super::sibling(&tmp, &format!(".evidence-{}", hex::encode(salt))),
                false,
            )?;
        }
        let identity = Identity::new(&tmp)?;
        let sd = identity.descriptor(&tmp, false)?;
        let mut file = open(
            &tmp,
            READ_CONTROL | READ | WRITE | DELETE,
            NEW,
            Some(&sd),
            false,
        )?;
        inspect(&file, &tmp, false)?;
        identity.check(&file, &tmp, true)?;
        #[cfg(test)]
        crash(1);
        file.write_all(bytes).map_err(|e| io(&tmp, e))?;
        file.sync_all().map_err(|e| io(&tmp, e))?;
        #[cfg(test)]
        crash(2);
        self.rename(&file, path, true)?;
        #[cfg(test)]
        crash(3);
        file.sync_all().map_err(|e| io(path, e))?;
        // No claim of directory/volume power-loss flush. Every returned native error refuses.
        Ok(())
    }
    pub(super) fn remove(&self, path: &Path) -> Result<(), StorageError> {
        let Some(file) = self.file(path, READ | DELETE, false)? else {
            return Ok(());
        };
        let mut delete = 1u8; // FILE_DISPOSITION_INFO.DeleteFile (BOOLEAN)
        if unsafe {
            SetFileInformationByHandle(file.as_raw_handle(), 4, (&mut delete as *mut u8).cast(), 1)
        } == 0
        {
            return Err(last(path));
        }
        drop(file);
        Ok(())
    }
}

