    #[test]
    fn c5_the_unkeyed_store_never_grants_restart_qualification_and_the_continuation_rule() {
        // Order C4: the file store can never claim the capability.
        const { assert!(!AnchorStore::GRANTS_RESTART_QUALIFICATION) };
        // Order C5, the rule for every backend: without the capability live qualification may
        // always continue (no stale state can qualify a restart); with it (no such backend exists)
        // never while a stale record could not be invalidated.
        for condition in [
            StoreCondition::Current,
            StoreCondition::NoLiveRecord,
            StoreCondition::StaleNotInvalidated,
        ] {
            assert!(
                live_qualification_may_continue(false, condition),
                "{condition:?}"
            );
            assert_eq!(
                live_qualification_may_continue(true, condition),
                condition != StoreCondition::StaleNotInvalidated,
                "{condition:?}"
            );
        }
    }

    #[test]
    fn c5_the_condition_follows_writes_failures_and_removal() {
        let anchor = dir("condition").join("clock.anchor");
        let (mut s, _) = open(&anchor);
        assert_eq!(s.condition(), StoreCondition::NoLiveRecord);
        s.commit(&record(1)).unwrap();
        assert_eq!(s.condition(), StoreCondition::Current);
        // A failed write whose possibly stale record WAS removed: nothing live remains.
        let blocked = sibling(&mark_path(&anchor), ".tmp");
        std::fs::create_dir(&blocked).unwrap();
        assert!(s.commit(&record(2)).is_err());
        assert_eq!(s.condition(), StoreCondition::NoLiveRecord);
        assert!(!anchor.exists());
        std::fs::remove_dir(&blocked).unwrap();
        s.commit(&record(3)).unwrap();
        assert_eq!(s.condition(), StoreCondition::Current);
        // A failed write whose record could NOT be removed (as after a failed removal): the
        // explicit stale condition, until an invalidation or a write succeeds.
        s.live_sequence = None;
        s.stale_file = true;
        assert_eq!(s.condition(), StoreCondition::StaleNotInvalidated);
        s.invalidate(9).unwrap();
        assert_eq!(s.condition(), StoreCondition::NoLiveRecord);
        s.commit(&record(s.next_sequence())).unwrap();
        assert_eq!(s.condition(), StoreCondition::Current);
    }

    #[cfg(unix)]
    #[test]
    fn c8_a_symbolic_link_at_the_record_or_mark_name_is_never_followed() {
        // Unix only (runs in the Linux campaign, not on the Windows development host).
        let root = dir("link");
        let anchor = root.join("clock.anchor");
        let (mut s, _) = open(&anchor);
        s.commit(&record(1)).unwrap();
        // The real files move aside and links take their names.
        let moved = root.join("moved.anchor");
        std::fs::rename(&anchor, &moved).unwrap();
        std::os::unix::fs::symlink(&moved, &anchor).unwrap();
        let (_, l) = open(&anchor);
        assert!(
            matches!(l.outcome, LoadOutcome::Refused(Refusal::Unreadable(_))),
            "{:?}",
            l.outcome
        );
        std::fs::remove_file(&anchor).unwrap();
        std::fs::rename(&moved, &anchor).unwrap();
        let mark = mark_path(&anchor);
        let moved_mark = root.join("moved.seq");
        std::fs::rename(&mark, &moved_mark).unwrap();
        std::os::unix::fs::symlink(&moved_mark, &mark).unwrap();
        let (_, l) = open(&anchor);
        assert_eq!(
            l.outcome,
            LoadOutcome::Refused(Refusal::Lineage(AnchorError::LineageMissing)),
            "an unreadable mark is no mark"
        );
    }

