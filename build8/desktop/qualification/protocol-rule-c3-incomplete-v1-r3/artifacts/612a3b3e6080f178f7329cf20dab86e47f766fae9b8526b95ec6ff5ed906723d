[package]
name = "mutinyd-v8"
version = "0.1.0"
edition = "2024"

[dependencies]
mutiny-crypto-v2 = { path = "../crypto-v2" }
mutiny-consensus-v8 = { path = "../consensus" }
mutiny-transport-v2 = { path = "../transport-v2" }
serde_json = "=1.0.151"
hex = "0.4"
sha2 = "0.10"
minicbor = { version = "=2.3.0", features = ["std"] }
ed25519-dalek = "=2.2.0"
getrandom = "=0.2.17"
zeroize = "=1.9.0"
rusqlite = { version = "=0.37.0", features = ["bundled"] }

[dev-dependencies]
mutiny-consensus-v8 = { path = "../consensus", features = ["actor-timer-test-fixtures"] }
p256 = { version = "=0.13.2", default-features = false, features = ["ecdsa", "std"] }

[target.'cfg(unix)'.dependencies]
libc = "=0.2.189"

[patch.crates-io]
hkdf = { path = "../qualification/crypto-v2-sources/kdf-custody-v1/hkdf" }
hmac = { path = "../qualification/crypto-v2-sources/kdf-custody-v1/hmac" }
sha2 = { path = "../qualification/crypto-v2-sources/kdf-custody-v1/sha2" }
block-buffer = { path = "../qualification/crypto-v2-sources/kdf-custody-v1/block-buffer" }
pbkdf2 = { path = "../qualification/crypto-v2-sources/kdf-custody-v1/pbkdf2" }
argon2 = { path = "../qualification/crypto-v2-sources/kdf-custody-v1/argon2" }
blake2 = { path = "../qualification/crypto-v2-sources/kdf-custody-v1/blake2" }

[features]
default=[]
# SERVICE-ONLY. Compiles the node-local trading service (node/src/trading_service_v1.rs and
# its storage) and HybridRuntime::preview_trading. It forwards NOTHING into
# mutiny-consensus-v8: trading, License and dividend validation is always compiled into
# consensus, so enabling or disabling this feature can never change which blocks, states or
# state roots a validator accepts.
trading-service=[]

# Shipping release profile (Build 8 configuration record: docs/BUILD-CONFIGURATIONS-V1.md).
# Profile tables are honoured only in the ROOT manifest being built, so every shipped root
# carries the same table. Cargo's release default would be overflow-checks = false while
# all tests run with it on; consensus arithmetic must behave identically in both.

# Two STAGED-ONLY overlay cfgs are referenced in node/src/trading_*_v1.rs. They are NOT Cargo
# features and are never enabled by any build or test; the code behind them is dead until a
# later package stages it (see docs/BUILD-CONFIGURATIONS-V1.md). They are declared here only so
# that `-D unexpected_cfgs` can pass without hiding any other unknown cfg. They gate no
# consensus rule.
[lints.rust]
unexpected_cfgs = { level = "warn", check-cfg = ['cfg(feature, values("trading-local-storage-candidate", "trading-bitcoin-candidate"))'] }

[profile.release]
opt-level = 3
# Checked integer arithmetic in the shipped binary (tests already run with checks on).
overflow-checks = true
debug-assertions = false
# One codegen unit: deterministic, reproducible code generation.
codegen-units = 1
# Symbols are kept: the exclusion checks (build/check-shipping-config.sh) inspect them.
strip = "none"
# LTO off: it is not needed for correctness, and the C sources compiled by build.rs make
# cross-language LTO an unverified variable. Revisit only with a reproducibility test.
lto = false
# UNWIND, deliberately. node/src/peer_supervisor.rs, actor_service.rs and
# hybrid_peer_worker_v2.rs detect a panicked worker through JoinHandle::join().is_err()
# and fail closed; panic = "abort" would remove that supervision. Abort is not provably safe.
panic = "unwind"
